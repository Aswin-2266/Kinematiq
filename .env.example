# Kinematiq Environment Configuration

# MongoDB Atlas Cloud Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/kinematiq?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/kinematiq?retryWrites=true&w=majority

# JWT Authentication Secret (Generate any random 32+ char string)
JWT_SECRET=kinematiq_super_secret_jwt_key_2026_change_in_production

# Optional NextAuth / Site URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
